59375 36.35784912109375 76.30142211914062Q52.04412841796875 91.4803466796875 65.0882568359375 127.24017333984375L248.2647705078125 635.2843017578125L376.9508056640625 651.9558715820312L387.24981689453125 648.0147094726562Q387.24981689453125 648.0147094726562 393.9140319824219 622.87255859375Q400.5782470703125 597.7304077148438 412.2424621582031 554.5882568359375Q423.90667724609375 511.44610595703125 438.9140319824219 457.1250305175781Q453.92138671875 402.803955078125 470.2718811035156 344.2818908691406Q486.62237548828125 285.75982666015625 503.3233642578125 229.186279296875Q520.0243530273438 172.61273193359375 535.0831909179688 126.13720703125Q546.097900390625 90.12249755859375 564.2988891601562 74.95828247070312Q582.4998779296875 59.7940673828125 618.9312744140625 56.450927734375L622.5734252929688 50.4803466796875L615.2449951171875 -3Q615.2449951171875 -3 594.2670593261719 -2.164215087890625Q573.2891235351562 -1.32843017578125 545.8258972167969 -0.82843017578125Q518.3626708984375 -0.32843017578125 497.74993896484375 -0.32843017578125Q456.7940673828125 -0.32843017578125 419.1739807128906 -2.335784912109375Q381.55389404296875 -4.3431396484375 358.2548828125 -6.51470947265625Q334.95587158203125 -8.686279296875 334.95587158203125 -8.686279296875ZM212.91656494140625 282.196044921875H288.7646484375Q305.80877685546875 282.196044921875 329.21075439453125 283.7033996582031Q352.61273193359375 285.21075439453125 368.29901123046875 286.21075439453125L304.078369140625 519.6373291015625H292.15191650390625Z"/></g></g></svg><span>{{ site.name }}</span></a>
    <nav aria-label="{{ T.ui.nav }}">
      <ul>
      {%- for key in ["research", "publications", "teaching", "service", "projects", "cv"] %}
        {%- set path = "/" + key + "/" %}
        <li><a href="{{ L.prefix }}{{ path }}"{% if pagePath == path %} aria-current="page"{% endif %}>{{ T.nav[key] }}</a></li>
      {%- endfor %}
      </ul>
    </nav>
    <div class="controls">
      <details class="lang-menu">
        <summary title="{{ T.ui.language }}">{{ L.flag | safe }}<span class="visually-hidden">{{ T.ui.language }}: </span><span class="lang-code" aria-hidden="true">{{ L.short }}</span><span class="visually-hidden">{{ L.name }}</span></summary>
        <ul class="lang-list">
        {%- for l in languages %}
          <li><a href="{{ l.prefix }}{{ pagePath }}" hreflang="{{ l.code }}" lang="{{ l.code }}"{% if l.code == L.code %} aria-current="true"{% endif %}>{{ l.flag | safe }}<span class="lang-name">{{ l.name }}</span></a></li>
        {%- endfor %}
        </ul>
      </details>
      <button class="theme-toggle" type="button" aria-label="{{ T.ui.dark }}" title="{{ T.ui.dark }}" data-dark="{{ T.ui.dark }}" data-light="{{ T.ui.light }}">
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 14.6A8.5 8.5 0 0 1 9.4 3.8a8.5 8.5 0 1 0 10.8 10.8Z"/></svg>
      </button>
    </div>
  </div>
</header>
<main id="main" class="wrap">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p>{{ site.name }}, {{ T.person.department }}, {{ T.person.university }}.</p>
    <p>{{ T.person.address }}</p>
  </div>
</footer>
<a class="to-top" href="#top" aria-label="{{ T.ui.top }}"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 12.5 10 7.5l5 5"/></svg></a>
</body>
</html>
