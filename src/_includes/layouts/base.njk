<!doctype html>
<html lang="{{ lang or site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + site.name) if title else (site.name + ", " + site.university) %}
{%- set pageDesc = description or site.description %}
{%- set canonical = page.url | absolute(site.url) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#151a22" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="{{ 'profile' if page.url == '/' else 'website' }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ 'it_IT' if lang == 'it' else 'en_US' }}">
{%- if page.url == '/' %}
<meta property="profile:first_name" content="{{ site.givenName }}">
<meta property="profile:last_name" content="{{ site.familyName }}">
{%- endif %}
{%- if site.photo %}
<meta property="og:image" content="{{ (site.photoShare or site.photo) | absolute(site.url) }}">
<meta name="twitter:card" content="summary">
{%- else %}
<meta name="twitter:card" content="summary">
{%- endif %}
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/alegreya-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
<script src="/assets/js/site.js" defer></script>
<script src="/assets/js/af-bg.js" defer></script>
{%- if math %}
<link rel="stylesheet" href="/assets/katex/katex.min.css">
{%- endif %}
{%- if page.url == '/' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": {{ site.name | json | safe }},
  "givenName": {{ site.givenName | json | safe }},
  "familyName": {{ site.familyName | json | safe }},
  "jobTitle": {{ site.position | json | safe }},
  "url": {{ site.url | json | safe }},
  {%- if site.photo %}
  "image": {{ site.photo | absolute(site.url) | json | safe }},
  {%- endif %}
  "affiliation": {
    "@type": "CollegeOrUniversity",
    "name": {{ site.university | json | safe }},
    "url": {{ site.universityUrl | json | safe }},
    "department": { "@type": "Organization", "name": {{ site.department | json | safe }}, "url": {{ site.departmentUrl | json | safe }} }
  },
  "workLocation": { "@type": "Place", "address": {{ site.address | json | safe }} },
  "knowsAbout": ["Formal argumentation", "Knowledge representation and reasoning", "Computational complexity", "Explainable artificial intelligence", "Logic programming", "Incomplete data management"],
  "sameAs": [{% for p in site.profiles %}{{ p.url | json | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
}
</script>
{%- endif %}
</head>
<body id="top">
<div class="aurora" aria-hidden="true"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
<canvas class="af-bg" aria-hidden="true"></canvas>
<div class="progress" aria-hidden="true"></div>
<a class="skip" href="#main">{{ "Vai al contenuto" if lang == "it" else "Skip to content" }}</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="wordmark" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ site.name }}</a>
    <nav aria-label="Main">
      <ul>
      {%- for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
      {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
<main id="main" class="wrap">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p>{{ site.name }}, {{ site.department }}, {{ site.university }}.</p>
    <p>{{ site.address }}</p>
    <p class="bg-note">{{ "Sullo sfondo: un framework di argomentazione bipolare. Le frecce continue sono attacchi, quelle tratteggiate supporti; i colori sono l'etichettatura grounded, ricalcolata a ogni cambiamento." if lang == "it" else "In the background: a bipolar argumentation framework. Solid arrows are attacks, dashed arrows supports; colours show its grounded labelling, recomputed after every change." }}</p>
  </div>
</footer>
<a class="to-top" href="#top" aria-label="{{ 'Torna su' if lang == 'it' else 'Back to top' }}"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 12.5 10 7.5l5 5"/></svg></a>
</body>
</html>
