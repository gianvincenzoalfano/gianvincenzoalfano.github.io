<!doctype html>
{%- set L = L or languages[0] %}
{%- set T = i18n[L.code] %}
{%- set pagePath = pagePath or "/" %}
<html lang="{{ L.code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>(function(d){d.classList.add("js");try{var t=localStorage.getItem("theme");if(t==="dark"||t==="light")d.setAttribute("data-theme",t)}catch(e){}})(document.documentElement)</script>
{%- set pageTitle = (title + " | " + site.name) if title else (site.name + ", " + T.person.university) %}
{%- set pageDesc = description or T.desc.home %}
{%- set canonical = page.url | absolute(site.url) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#151a22" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="{{ 'profile' if pagePath == '/' else 'website' }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ L.locale }}">
{%- for l in languages %}{% if l.code != L.code %}
<meta property="og:locale:alternate" content="{{ l.locale }}">
{%- endif %}{% endfor %}
{%- if not noAlternates %}
{%- for l in languages %}
<link rel="alternate" hreflang="{{ l.code }}" href="{{ (l.prefix + pagePath) | absolute(site.url) }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ pagePath | absolute(site.url) }}">
{%- endif %}
{%- if pagePath == '/' %}
<meta property="profile:first_name" content="{{ site.givenName }}">
<meta property="profile:last_name" content="{{ site.familyName }}">
{%- endif %}
{%- if site.photo %}
<meta property="og:image" content="{{ (site.photoShare or site.photo) | absolute(site.url) }}">
<meta name="twitter:card" content="summary">
{%- else %}
<meta name="twitter:card" content="summary">
{%- endif %}
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/assets/img/favicon.svg?v={{ build.v }}" type="image/svg+xml">
<link rel="icon" href="/assets/img/favicon-96.png" type="image/png" sizes="96x96">
<link rel="icon" href="/assets/img/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/alegreya-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css?v={{ build.v }}">
<script src="/assets/js/site.js?v={{ build.v }}" defer></script>
<script src="/assets/js/af-bg.js?v={{ build.v }}" defer></script>
{%- if math %}
<link rel="stylesheet" href="/assets/katex/katex.min.css">
{%- endif %}
{%- if pagePath == '/' and not noAlternates %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": {{ site.name | json | safe }},
  "givenName": {{ site.givenName | json | safe }},
  "familyName": {{ site.familyName | json | safe }},
  "jobTitle": {{ T.person.position | json | safe }},
  "url": {{ page.url | absolute(site.url) | json | safe }},
  {%- if site.photo %}
  "image": {{ site.photo | absolute(site.url) | json | safe }},
  {%- endif %}
  "affiliation": {
    "@type": "CollegeOrUniversity",
    "name": {{ site.university | json | safe }},
    "url": {{ site.universityUrl | json | safe }},
    "department": { "@type": "Organization", "name": {{ site.department | json | safe }}, "url": {{ site.departmentUrl | json | safe }} }
  },
  "workLocation": { "@type": "Place", "address": {{ site.address | json | safe }} },
  "knowsAbout": ["Formal argumentation", "Knowledge representation and reasoning", "Computational complexity", "Explainable artificial intelligence", "Logic programming", "Incomplete data management"],
  "sameAs": [{% for p in site.profiles %}{{ p.url | json | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
}
</script>
{%- endif %}
</head>
<body id="top">
<div class="aurora" aria-hidden="true"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
<canvas class="af-bg" aria-hidden="true"></canvas>
<div class="progress" aria-hidden="true"></div>
<a class="skip" href="#main">{{ T.ui.skip }}</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="wordmark" href="{{ L.prefix }}/"{% if pagePath == "/" %} aria-current="page"{% endif %}><svg xmlns="http://www.w3.org/2000/svg" viewBox="-60 -15 1460.5734252929688 1427" class="logo" width="60" height="60" aria-hidden="true" focusable="false"><path d="M1083 295 Q680 -215 276 295" fill="none" stroke="var(--out, #9a3b3b)" stroke-width="46" stroke-linecap="round"/><path d="M276 295 L303 135 L426 232Z" fill="var(--out, #9a3b3b)"/><path d="M276 1082 Q670 1572 1038 1114" fill="none" stroke="var(--in, #1d6b57)" stroke-width="120" stroke-linecap="butt"/><path d="M276 1082 Q670 1572 1038 1114" fill="none" stroke="var(--paper, #fcfcfa)" stroke-width="41" stroke-linecap="square"/><path d="M1063 1259 L1063 1082 L891 1120" fill="none" stroke="var(--in, #1d6b57)" stroke-width="46" stroke-linecap="round" stroke-linejoin="round"/><g fill="currentColor"><g transform="translate(0 1000) scale(1 -1)"><path d="M328.058837890625 -11.67156982421875Q236.75982666015625 -11.67156982421875 170.2745361328125 26.32843017578125Q103.78924560546875 64.32843017578125 67.78924560546875 134.813720703125Q31.78924560546875 205.29901123046875 31.78924560546875 301.5980224609375Q31.78924560546875 409.55389404296875 74.96817016601562 488.0612487792969Q118.1470947265625 566.568603515625 197.97552490234375 609.4264526367188Q277.803955078125 652.2843017578125 386.07354736328125 652.2843017578125Q418.38726806640625 652.2843017578125 453.04412841796875 648.6200866699219Q487.70098876953125 644.9558715820312 517.0294189453125 639.9558715820312Q546.3578491210938 634.9558715820312 564.6936340332031 631.2916564941406Q583.0294189453125 627.62744140625 583.0294189453125 627.62744140625L589.3284301757812 617.0294189453125Q589.3284301757812 617.0294189453125 584.0 593.3799133300781Q578.6715698242188 569.7304077148438 572.1715698242188 529.2671813964844Q565.6715698242188 488.803955078125 562.6715698242188 438.53436279296875L480.529541015625 432.8922119140625Q480.529541015625 432.8922119140625 481.865325927