---
layout: layouts/base.njk
pagination: { data: languages, size: 1, alias: L, addAllPagesToCollections: true }
pagePath: /publications/
permalink: "{{ L.prefix }}/publications/"
eleventyComputed:
  title: "{{ i18n[L.code].nav.publications }}"
  description: "{{ i18n[L.code].desc.publications }}"
---
{%- set U = i18n[L.code].pubs -%}
<h1>{{ U.title }}</h1>
<p class="page-intro">{{ U.intro | fmt({ n: publications.total, dblp: '<a href="https://dblp.org/pid/204/2966.html">DBLP</a>', scholar: '<a href="https://scholar.google.it/citations?user=0ndOUs8AAAAJ&amp;hl=it&amp;oi=ao">Google Scholar</a>' }) | safe }}</p>

<div class="pub-list">
  <fieldset class="pub-filter">
    <legend>{{ U.show }}</legend>
    <input type="radio" name="pubcat" id="f-all" checked><label for="f-all">{{ U.all }}<span class="n">{{ publications.total }}</span></label>
    {%- for c in publications.categories %}
    <input type="radio" name="pubcat" id="f-{{ c.id }}"><label for="f-{{ c.id }}">{{ U.cats[c.id] }}<span class="n">{{ publications.counts[c.id] }}</span></label>
    {%- endfor %}
  </fieldset>

  {%- for y in publications.years %}
  <section class="pub-year" data-cats="{{ y.cats }}" aria-labelledby="y{{ y.year }}">
    <h2 id="y{{ y.year }}">{{ y.year }}</h2>
    <ol class="pubs">
    {%- for p in y.items %}
      <li class="pub" id="{{ p.key }}" data-cat="{{ p.cat }}">
        <span class="pub-title">{{ p.title | safe }}</span>
        <span class="pub-authors">{% for a in p.people %}{% if a.self %}<strong>{{ a.name }}</strong>{% else %}{{ a.name }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</span>
        <span class="pub-venue">{{ p.venue | safe }}</span>
        {%- if p.note %}<span class="pub-note">{{ p.note | safe }}</span>{% endif %}
        {%- if p.award %}<span class="award">{{ p.award }}</span>{% endif %}
        <span class="pub-links">
          {%- for l in p.links %}<a href="{{ l.url }}">{{ U.slides if l.label == "Slides" else l.label }}</a>{% endfor %}
          <details><summary>BibTeX</summary><pre>{{ p.bibtex }}</pre></details>
        </span>
      </li>
    {%- endfor %}
    </ol>
  </section>
  {%- endfor %}
</div>
