---
layout: layouts/base.njk
title: Publications
description: Publications of Gianvincenzo Alfano on formal argumentation, computational complexity, explainable AI and data management.
---
<h1>Publications</h1>
<p class="page-intro">{{ publications.total }} works, newest first. The list is generated from <a href="https://github.com/gianvincenzoalfano/gianvincenzoalfano.github.io/blob/main/publications.bib">publications.bib</a>; each entry has its BibTeX. Complete and up-to-date records are also on <a href="https://dblp.org/pid/204/2966.html">DBLP</a> and <a href="https://scholar.google.com/citations?user=0ndOUs8AAAAJ">Google Scholar</a>.</p>

<div class="pub-list">
  <fieldset class="pub-filter">
    <legend>Show</legend>
    <input type="radio" name="pubcat" id="f-all" checked><label for="f-all">All<span class="n">{{ publications.total }}</span></label>
    {%- for c in publications.categories %}
    <input type="radio" name="pubcat" id="f-{{ c.id }}"><label for="f-{{ c.id }}">{{ c.label }}<span class="n">{{ publications.counts[c.id] }}</span></label>
    {%- endfor %}
  </fieldset>

  {%- for y in publications.years %}
  <section class="pub-year" data-cats="{{ y.cats }}" aria-labelledby="y{{ y.year }}">
    <h2 id="y{{ y.year }}">{{ y.year }}</h2>
    <ol class="pubs">
    {%- for p in y.items %}
      <li class="pub" id="{{ p.key }}" data-cat="{{ p.cat }}">
        <span class="pub-title">{{ p.title | safe }}</span>
        <span class="pub-authors">{% for a in p.people %}{% if a.self %}<strong>{{ a.name }}</strong>{% else %}{{ a.name }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</span>
        <span class="pub-venue">{{ p.venue | safe }}</span>
        {%- if p.note %}<span class="pub-note">{{ p.note | safe }}</span>{% endif %}
        {%- if p.award %}<span class="award">{{ p.award }}</span>{% endif %}
        <span class="pub-links">
          {%- for l in p.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
          <details><summary>BibTeX</summary><pre>{{ p.bibtex }}</pre></details>
        </span>
      </li>
    {%- endfor %}
    </ol>
  </section>
  {%- endfor %}
</div>
