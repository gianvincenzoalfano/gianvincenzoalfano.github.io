---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}index.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Moved</title>
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ r.to | absolute(site.url) }}">
<meta http-equiv="refresh" content="0; url={{ r.to }}">
</head>
<body>
<p>This page has moved to <a href="{{ r.to }}">{{ r.to | absolute(site.url) }}</a>.</p>
</body>
</html>
